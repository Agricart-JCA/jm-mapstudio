# ── WhatsApp Cloud API (Meta) ─────────────────────────────────
# Configure esses valores como Secrets da Edge Function no Supabase:
# Supabase Dashboard → Edge Functions → Secrets

# Token de acesso permanente (gerado em developers.facebook.com)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxx...

# Phone Number ID (encontrado em Meta for Developers → WhatsApp → API Setup)
WHATSAPP_PHONE_ID=1234567890123456

# Token de verificação — você define (qualquer string segura)
WHATSAPP_VERIFY_TOKEN=jm-mapstudio-verify-2024

# ── URL do webhook (para cadastrar no Meta) ───────────────────
# https://zzjizqiafnnuqmrkhjqj.supabase.co/functions/v1/whatsapp-webhook
